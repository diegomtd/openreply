# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Worker / VPS tuning (all optional — these are the defaults)
# Jobs the worker handles at once. Low on purpose: the work is waiting on Meta,
# not CPU, and this usually runs beside the web app on one small box.
WORKER_CONCURRENCY=2
# How often the polling safety net sweeps for comments the webhook missed.
COMMENT_POLL_INTERVAL_MS=900000
COMMENT_POLL_LOOKBACK_HOURS=72
COMMENT_POLL_MAX_PER_SWEEP=30

# Data retention, in days, for the /api/cron/prune sweep. DmLog and contacts are
# never pruned — only raw webhook payloads, INFO events, and the comment dedup set.
DATA_RETENTION_WEBHOOK_DAYS=7
DATA_RETENTION_EVENT_DAYS=14
DATA_RETENTION_COMMENT_DAYS=30
