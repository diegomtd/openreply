// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  /// Anti-flood across every automation in the workspace: one person receives at
  /// most one automated DM per this many hours, no matter how many campaigns
  /// they match. 0 disables the global cap and leaves frequency entirely to each
  /// automation's own sendFrequency.
  contactCooldownHours Int @default(12)
  /// Extra words that opt a contact out of every automation when they DM them.
  /// Merged with the built-in list (stop / parar / sair / cancelar / …).
  optOutKeywords       String[] @default([])

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  contacts          Contact[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]
  followerSnapshots FollowerSnapshot[]
  contacts    Contact[]

  @@index([workspaceId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled Boolean @default(false)
  /// Fire on a reply to one of the account's stories whose text matches the
  /// keywords. A story reply arrives through the same webhook as a DM, so
  /// without this it was indistinguishable from one.
  storyReplyTriggerEnabled Boolean @default(false)
  /// Fire when someone mentions the account in their story. Carries no text, so
  /// keywords do not apply — every mention matches.
  storyMentionTriggerEnabled Boolean @default(false)
  dmMessage      String
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  /// LEGADO — substituído por `steps` (AutomationStep). A migration
  /// `add_automation_steps` copiou estes três campos para um passo de ordem 1, e
  /// o worker só lê `steps` desde então. Mantidos para não perder dado e para um
  /// rollback continuar possível; **não escreva neles em código novo.**
  followUpEnabled Boolean @default(false)
  followUpMessage String?
  followUpDelayMinutes Int @default(0)
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  /// How often the same person may receive this automation. Defaults to once
  /// ever, because re-sending the same automated message to someone who already
  /// got it is the single most common way this tool annoys real users.
  sendFrequency       SendFrequency @default(ONCE_PER_CONTACT)
  /// Only read when sendFrequency is COOLDOWN: hours to wait before the same
  /// person may receive this automation again.
  resendCooldownHours Int           @default(24)
  /// Só envia para quem tem TODAS estas tags. Vazio = sem exigência.
  requiredTags String[] @default([])
  /// Nunca envia para quem tem QUALQUER uma destas tags. Vazio = sem exclusão.
  excludedTags String[] @default([])
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]
  contactStates    ContactAutomationState[]
  steps            AutomationStep[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

/// Uma mensagem da sequência que sai DEPOIS do link, na ordem.
///
/// Substitui o antigo trio `followUp*`, que só permitia uma mensagem. Serve para
/// qualificar em DM ("de onde você me achou?", "quer que eu te mande o resto?")
/// em vez de entregar um link e encerrar a conversa.
///
/// `delayMinutes` é relativo ao passo anterior, não ao início. A soma dos
/// atrasos tem que caber na janela de 24h de mensagens do Instagram — passado
/// isso a Meta recusa o envio — então a API valida o acumulado.
model AutomationStep {
  id           String @id @default(cuid())
  automationId String
  /// 1, 2, 3… A ordem de envio.
  order        Int
  message      String
  /// Minutos a esperar depois do passo anterior (ou depois do link, no passo 1).
  delayMinutes Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, order])
  @@index([automationId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  /// Quando a pessoa leu o DM, pelo recibo de leitura da Meta. O recibo é um
  /// watermark ("li tudo até este instante"), então isto é preenchido por
  /// varredura: todo envio para este contato anterior ao watermark conta como
  /// lido. Fica nulo se a Meta não mandar recibo.
  readAt        DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
  @@index([commenterId])
  @@index([automationId, commenterId])
  @@index([instagramAccountId, commenterId, dmSentAt])
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

/// A person who has interacted with one connected Instagram account, keyed by
/// their IGSID. This is the entity automation frequency is decided against:
/// "has this person already had this?" rather than "have I seen this message
/// id?". Without it, every inbound DM re-triggers the same automation forever.
model Contact {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  /// Instagram-scoped user id from the webhook. Unique per connected account.
  igsid              String
  username           String?
  name               String?

  firstSeenAt   DateTime  @default(now())
  lastInboundAt DateTime?

  /// Last time ANY automation delivered a message to this person, and how many
  /// in total. Drives the workspace-wide anti-flood cap.
  lastAutomationSentAt DateTime?
  automationSentCount  Int       @default(0)

  /// Opted out of every automation — by sending a stop word, or muted by hand
  /// from the Contacts screen. Never receives an automated message again.
  optedOut       Boolean   @default(false)
  optedOutAt     DateTime?
  optedOutReason String?

  tags String[] @default([])
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  automationStates ContactAutomationState[]

  @@unique([instagramAccountId, igsid])
  @@index([workspaceId])
  @@index([workspaceId, lastAutomationSentAt])
  @@index([workspaceId, optedOut])
}

/// One row per (person, automation, scope) that has actually been delivered.
/// `scopeKey` is the media id for a comment trigger and the literal "dm" for the
/// DM trigger, which is what lets ONCE_PER_POST behave like ManyChat (one send
/// per person per post) while ONCE_PER_CONTACT ignores the scope entirely.
model ContactAutomationState {
  id           String @id @default(cuid())
  contactId    String
  automationId String
  scopeKey     String

  sentCount   Int      @default(0)
  firstSentAt DateTime @default(now())
  lastSentAt  DateTime @default(now())

  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([contactId, automationId, scopeKey])
  @@index([automationId])
  @@index([contactId, lastSentAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
  /// This person already received this automation and it is set to send once.
  SKIPPED_ALREADY_SENT
  /// Blocked by a frequency window: the automation's own cooldown, or the
  /// workspace-wide anti-flood cap.
  SKIPPED_COOLDOWN
  /// The contact opted out (stop word) or was muted from the Contacts screen.
  SKIPPED_OPTED_OUT
  /// Blocked by the automation's tag condition (a required tag is missing, or an
  /// excluded tag is present).
  SKIPPED_TAG_RULE
}

enum SendFrequency {
  /// One delivery per person, ever, regardless of which post they came from.
  ONCE_PER_CONTACT
  /// One delivery per person per post (ManyChat's comment-trigger behaviour).
  /// Falls back to once-per-person for the DM trigger, which has no post.
  ONCE_PER_POST
  /// May send again once resendCooldownHours have passed.
  COOLDOWN
  /// No per-contact limit. Only the workspace anti-flood cap applies.
  ALWAYS
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}
